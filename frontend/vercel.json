{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "solid-eat.fr"
        }
      ],
      "destination": "https://solid-eat.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "solid-eat.fr"
        }
      ],
      "destination": "https://solid-eat.com/:path+",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.solid-eat.fr"
        }
      ],
      "destination": "https://solid-eat.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "www.solid-eat.fr"
        }
      ],
      "destination": "https://solid-eat.com/:path+",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.solid-eat.com"
        }
      ],
      "destination": "https://solid-eat.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "www.solid-eat.com"
        }
      ],
      "destination": "https://solid-eat.com/:path+",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
